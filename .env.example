# Logical AI Environment Configuration

# Authentication Secret (Optional - safe built-in default is provided)
JWT_SECRET=LOGICAL_AI_ULTRA_SECRET_KEY_FOR_COLLEGE_PROJECT

# External AI Provider Configuration
# Supported providers: gemini, openai, groq, openrouter, deepseek, anthropic, or custom
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_BASE_URL=
AI_MODEL=gemini-1.5-flash

# Common Configuration Reference:
# 1. Google Gemini:
#    AI_PROVIDER=gemini
#    AI_API_KEY=AIzaSy...
#    AI_MODEL=gemini-1.5-flash (or gemini-2.0-flash)
#
# 2. OpenAI:
#    AI_PROVIDER=openai
#    AI_API_KEY=sk-...
#    AI_MODEL=gpt-4o-mini (or gpt-4o)
#
# 3. Groq (Ultra-Fast):
#    AI_PROVIDER=groq
#    AI_API_KEY=gsk_...
#    AI_MODEL=llama-3.3-70b-versatile
#
# 4. OpenRouter:
#    AI_PROVIDER=openrouter
#    AI_API_KEY=sk-or-...
